rules_version = '2';

// Who may read and change a shared mesa. The app hides what a person cannot
// do, but these rules are what actually enforces it.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function mesaPath(mesa) { return /databases/$(db)/documents/mesas/$(mesa); }
    function memberPath(mesa, uid) { return /databases/$(db)/documents/mesas/$(mesa)/members/$(uid); }
    function invitePath(mesa) { return /databases/$(db)/documents/mesas/$(mesa)/private/invite; }
    function joinPath(mesa, uid) { return /databases/$(db)/documents/mesas/$(mesa)/joins/$(uid); }

    // Reading: as things are now.
    function isMember(mesa) { return signedIn() && exists(memberPath(mesa, me())); }

    // Writing: as things will be once the write lands, so a mesa and its
    // first owner can be created in one batch.
    function memberAfter(mesa) { return getAfter(memberPath(mesa, me())).data; }
    function joinedAfter(mesa) { return signedIn() && existsAfter(memberPath(mesa, me())); }
    function isOwner(mesa) { return joinedAfter(mesa) && memberAfter(mesa).owner == true; }
    function canScore(mesa) {
      return joinedAfter(mesa) && (memberAfter(mesa).owner == true || memberAfter(mesa).scores == true);
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validName(name) { return name is string && name.size() > 0 && name.size() <= 32; }

    match /mesas/{mesa} {
      allow read: if isMember(mesa);
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && request.resource.data.keys().hasOnly(['name', 'players', 'teams', 'createdBy', 'createdAt'])
        && validName(request.resource.data.name);
      allow update: if isOwner(mesa)
        && changedOnly(['name', 'players', 'teams'])
        && validName(request.resource.data.name);
      allow delete: if isOwner(mesa);

      // The code in the mesa's link: owners only.
      match /private/{docId} {
        allow read: if isMember(mesa) && get(memberPath(mesa, me())).data.owner == true;
        allow write: if isOwner(mesa);
      }

      match /members/{uid} {
        allow read: if isMember(mesa);

        // Joining by link: yourself, watching only, with the current code written
        // in the same batch to a place no member can read (see joins below).
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['name', 'owner', 'scores', 'joinedAt'])
          && validName(request.resource.data.name)
          && request.resource.data.owner == false
          && request.resource.data.scores == false
          && exists(invitePath(mesa))
          && existsAfter(joinPath(mesa, me()))
          && getAfter(joinPath(mesa, me())).data.token == get(invitePath(mesa)).data.token;

        // The person who shares a mesa is its first owner, in the batch that creates it.
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['name', 'owner', 'scores', 'joinedAt'])
          && validName(request.resource.data.name)
          && !exists(mesaPath(mesa))
          && getAfter(mesaPath(mesa)).data.createdBy == me()
          && request.resource.data.owner == true;

        // Your own name is yours; what others may do is the owners' to decide,
        // and nobody changes their own role.
        allow update: if (me() == uid && changedOnly(['name']) && validName(request.resource.data.name))
          || (isOwner(mesa) && me() != uid && changedOnly(['owner', 'scores']));

        // Leave, or be taken out by an owner.
        allow delete: if signedIn() && (me() == uid || isOwner(mesa));
      }

      // Whoever may score writes the match they finish; two phones finishing
      // the same match write the same record. Only owners remove one.
      // The code a person joined with: written by them, read by nobody but owners.
      match /joins/{uid} {
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['token']);
        allow read, delete: if isOwner(mesa) || (signedIn() && me() == uid);
      }

      match /matches/{matchId} {
        allow read: if isMember(mesa);
        allow create, update: if canScore(mesa);
        allow delete: if isOwner(mesa);
      }

      match /live/{docId} {
        allow read: if isMember(mesa);
        allow write: if canScore(mesa);
      }
    }
  }
}
